            <div class="card-body">
                <h3>Clients</h3>
                <p>Manage company clients</p>
                <a asp-controller="Clients"
                   asp-action="Index"
                   class="btn btn-primary">
                    View Clients
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
